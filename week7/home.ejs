<!DOCTYPE html>
<html>
<head>
    <title><%= heading %></title>
    <style>
        .error {
            color: red;
            font-weight: bold;
        }
        .success {
            color: green;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1><%= heading %></h1>
    <% if (message) { %>
        <p class="error"><%= message %></p>
    <% } %>
    <% if (participant) { %>
        <p class="success">
            Welcome, <%= participant %>! Your registration is complete.
        </p>
        <a href="/">Register another participant</a>
    <% } else { %>
        <form action="/register" method="POST">
            <label>Participant Name:</label>
            <input type="text" name="name">
            <br><br>
            <label>Age:</label>
            <input type="number" name="age">
            <br><br>
            <button type="submit">Register</button>
        </form>
    <% } %>
</body>
</html>
